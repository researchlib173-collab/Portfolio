    <Cell><Data ss:Type="String">Search Operators: Screenshot 1</Data></Cell>
    <Cell ss:StyleID="HighlightID"><Data ss:Type="String">N/A</Data></Cell>
    <Cell ss:StyleID="HighlightClass"><Data ss:Type="String">.collage-card, .card-search-1</Data></Cell>
